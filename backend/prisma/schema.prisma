generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id           String    @id @default(uuid())
  customerName String
  title        String
  description  String
  priority     Priority  @default(MEDIUM)
  status       Status    @default(OPEN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     Comment[]

  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  author    String
  message   String
  createdAt DateTime @default(now())

  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}